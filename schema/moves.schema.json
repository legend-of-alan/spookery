{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "CC BY 4.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "moves"],
  "properties": {
    "schema": { "const": "moves/v0" },
    "moves": {
      "type": "array",
      "items": { "$ref": "#/$defs/move" }
    }
  },
  "$defs": {
    "move": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "check": { "type": "string" },
        "token": { "enum": ["none", "actor", "place"] },
        "on": { "enum": ["speaker", "named"] },
        "effects": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              { "$ref": "#/$defs/flag" },
              { "$ref": "#/$defs/location" }
            ]
          }
        }
      },
      "allOf": [
        {
          "if": { "required": ["effects"] },
          "then": {
            "required": ["token", "on", "effects"],
            "not": { "required": ["check"] }
          }
        },
        {
          "if": { "required": ["token", "on"] },
          "then": { "required": ["effects"] }
        },
        {
          "if": {
            "properties": { "token": { "const": "none" } },
            "required": ["token"]
          },
          "then": { "properties": { "on": { "const": "speaker" } } }
        },
        {
          "if": {
            "properties": { "token": { "const": "actor" } },
            "required": ["token"]
          },
          "then": { "properties": { "on": { "const": "named" } } }
        },
        {
          "if": {
            "properties": { "token": { "const": "place" } },
            "required": ["token"]
          },
          "then": {
            "properties": {
              "on": { "const": "speaker" },
              "effects": { "items": { "$ref": "#/$defs/location" } }
            }
          }
        },
        {
          "if": {
            "properties": { "token": { "enum": ["none", "actor"] } },
            "required": ["token"]
          },
          "then": {
            "properties": {
              "effects": { "items": { "$ref": "#/$defs/flag" } }
            }
          }
        },
        {
          "if": {
            "properties": {
              "name": {
                "enum": [
                  "say",
                  "talk",
                  "wait",
                  "attempt",
                  "attack",
                  "give",
                  "take"
                ]
              }
            },
            "required": ["name"]
          },
          "then": { "not": { "required": ["effects"] } }
        },
        {
          "if": {
            "properties": { "name": { "const": "travel" } },
            "required": ["name", "effects"]
          },
          "then": {
            "properties": {
              "token": { "const": "place" },
              "on": { "const": "speaker" },
              "effects": { "items": { "$ref": "#/$defs/location" } }
            }
          }
        }
      ]
    },
    "flag": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class", "key", "value"],
      "properties": {
        "class": { "const": "flag" },
        "key": { "type": "string", "not": { "const": "busy" } },
        "value": { "type": "boolean" }
      }
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class"],
      "properties": {
        "class": { "const": "location" }
      }
    }
  }
}
