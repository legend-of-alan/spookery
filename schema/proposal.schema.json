{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "CC BY 4.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "kind",
    "target",
    "summary",
    "actor_id",
    "source",
    "tick_index"
  ],
  "properties": {
    "schema": { "const": "proposal/v0" },
    "id": { "type": "string" },
    "kind": { "enum": ["delete_place", "patch_entity", "other"] },
    "target": { "type": "string" },
    "summary": { "type": "string" },
    "actor_id": { "type": "string" },
    "source": { "type": "string" },
    "tick_index": { "type": "integer", "minimum": 0 }
  }
}
