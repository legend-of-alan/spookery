{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "CC BY 4.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "kind", "facts"],
  "properties": {
    "schema": { "const": "cast/v0" },
    "id": { "type": "string" },
    "kind": { "enum": ["npc", "pc_template"] },
    "facts": {
      "type": "array",
      "items": { "$ref": "#/$defs/fact" }
    },
    "tick": { "$ref": "#/$defs/tick" }
  },
  "$defs": {
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text", "hidden"],
      "properties": {
        "id": { "type": "string" },
        "text": { "type": "string" },
        "hidden": { "type": "boolean" }
      }
    },
    "tick": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eligible"],
      "properties": {
        "eligible": { "type": "boolean" },
        "tier": { "enum": ["named", "major", "minor"] },
        "plot_relevant": { "type": "boolean" },
        "range": {
          "type": "array",
          "items": { "type": "string" }
        },
        "schedule": {
          "type": "array",
          "items": { "$ref": "#/$defs/schedule" }
        },
        "stock_rate": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": { "type": "integer" }
          }
        },
        "needs": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/bound" }
        },
        "resources": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/bound" }
        },
        "flags": {
          "type": "array",
          "items": { "type": "string" }
        },
        "work": { "$ref": "#/$defs/work" },
        "notes": {
          "type": "array",
          "items": { "$ref": "#/$defs/note" }
        }
      }
    },
    "schedule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end", "place"],
      "properties": {
        "start": { "type": "integer", "minimum": 0, "maximum": 24 },
        "end": { "type": "integer", "minimum": 0, "maximum": 24 },
        "place": { "type": "string" },
        "activity": { "enum": ["work", "rest"] },
        "rest_delta": { "type": "integer" }
      },
      "if": {
        "properties": { "activity": { "const": "rest" } },
        "required": ["activity"]
      },
      "then": { "required": ["rest_delta"] }
    },
    "bound": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "min": { "type": "integer" },
        "max": { "type": "integer" }
      }
    },
    "work": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "needs": {
          "type": "array",
          "items": { "$ref": "#/$defs/delta" }
        },
        "resources": {
          "type": "array",
          "items": { "$ref": "#/$defs/delta" }
        }
      }
    },
    "delta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "delta"],
      "properties": {
        "key": { "type": "string" },
        "delta": { "type": "integer" }
      }
    },
    "note": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "due_clock", "due_value", "to", "place", "fact_ids", "text"],
      "properties": {
        "id": { "type": "string" },
        "due_clock": { "type": "string" },
        "due_value": { "type": "integer" },
        "to": {
          "type": "array",
          "items": { "type": "string" }
        },
        "place": { "type": "string" },
        "fact_ids": {
          "type": "array",
          "items": { "type": "string" }
        },
        "text": { "type": "string" }
      }
    }
  }
}
