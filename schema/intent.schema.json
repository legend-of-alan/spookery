{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "CC BY 4.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "tick_index",
    "actor_id",
    "actor_kind",
    "source",
    "move",
    "target",
    "args",
    "rationale_code"
  ],
  "properties": {
    "id": { "type": "string" },
    "tick_index": { "type": "integer", "minimum": 0 },
    "actor_id": { "type": "string" },
    "actor_kind": { "enum": ["npc", "player", "system"] },
    "source": { "enum": ["kernel", "player", "system"] },
    "move": { "type": "string" },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "maxProperties": 1,
      "properties": {
        "place": { "type": "string" },
        "actor": { "type": "string" },
        "clock": { "type": "string" },
        "rumor": { "type": "string" }
      }
    },
    "args": { "type": "object" },
    "rationale_code": { "type": "string" }
  }
}
