# Generated by Cargo
/target/

# rustfmt backups
**/*.rs.bk

# MSVC debug info from Windows rustc builds
*.pdb

# Local Grok MCP paths and permission choices
/.grok/config.toml

# Point-in-time notes
/reports/

# Editor multi-root workspace files
*.code-workspace

# Personal Grok dev-workflow skills (kept per machine, not shipped)
/.grok/skills/review-impl/
/.grok/skills/review-plan/
/.grok/skills/spec-test-sync/

# Private planning notes read by those skills
/plans/
