{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Message",
  "description": "One message on a seat's stream. `id` is chosen by the client and comes back as\n`reply_to` on the reply. `seq` is set by the server, from one counter per table, on\neverything it sends but the hello. The body is nested, so its fields never clash with\nthese.",
  "type": "object",
  "properties": {
    "id": {
      "type": [
        "string",
        "null"
      ]
    },
    "seq": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint64",
      "minimum": 0
    },
    "reply_to": {
      "type": [
        "string",
        "null"
      ]
    },
    "body": {
      "$ref": "#/$defs/ClientBody"
    }
  },
  "required": [
    "body"
  ],
  "$defs": {
    "ClaimArgs": {
      "description": "`claim` arguments: a free PC, or the token of a claim this player held before and the\nlast `seq` it read.",
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "actor": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "actor"
          ]
        },
        {
          "type": "object",
          "properties": {
            "token": {
              "type": "string"
            },
            "last_seq": {
              "description": "The last `seq` the player read. A missing `last_seq` means 0, so the reply\ncatches up on everything the claim still keeps.",
              "type": "integer",
              "format": "uint64",
              "minimum": 0,
              "default": 0
            }
          },
          "additionalProperties": false,
          "required": [
            "token"
          ]
        }
      ]
    },
    "MoveArgs": {
      "description": "A pack verb's arguments, sent by a player seat.",
      "type": "object",
      "properties": {
        "target": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "NoArgs": {
      "description": "The arguments of a command that takes none.",
      "type": "object",
      "additionalProperties": false
    },
    "SayArgs": {
      "description": "The `say` command arguments of either seat, sent from a client to the table. Only the GM\nmay set `as`, the bare id of an NPC to speak as, and may then leave out `to`: the NPC's\nplace hears it.",
      "type": "object",
      "properties": {
        "to": {
          "anyOf": [
            {
              "description": "Who hears a say: everyone at the table, everyone in one place, or one actor. On the wire\nit is `\"table\"`, `{\"place\": \"<id>\"}` or `{\"actor\": \"<id>\"}`.",
              "oneOf": [
                {
                  "type": "string",
                  "enum": [
                    "table"
                  ]
                },
                {
                  "type": "object",
                  "properties": {
                    "place": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "place"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "actor": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "actor"
                  ],
                  "additionalProperties": false
                }
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "text": {
          "type": "string"
        },
        "as": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "text"
      ]
    },
    "PerceiveArgs": {
      "description": "The GM's `perceive` command arguments, sent from a GM client to the table.",
      "type": "object",
      "properties": {
        "as": {
          "description": "The actor whose view the GM reads. The schema requires it, and the table refuses a call\nwithout it as `UNSCOPED_PERCEIVE`.",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "as"
      ]
    },
    "QueueArgs": {
      "description": "The GM's `queue` command arguments, sent from a GM client to the table.\nSerialized, a call names only the fields that are set.",
      "type": "object",
      "properties": {
        "id": {
          "type": [
            "string",
            "null"
          ]
        },
        "round_index": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "actor": {
          "description": "The actor the move is for. The schema requires it, and the table refuses a call without\nit as `SCHEMA`.",
          "type": "string"
        },
        "move": {
          "description": "The move to queue. The schema requires it, and the table refuses a call without it as\n`SCHEMA`.",
          "type": "string"
        },
        "target": {
          "type": [
            "string",
            "null"
          ]
        },
        "to": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "rationale_code": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "actor",
        "move"
      ]
    },
    "CommitArgs": {
      "description": "The GM's `commit` command arguments, sent from a GM client to the table.",
      "type": "object",
      "properties": {
        "include_round": {
          "type": "boolean"
        },
        "session_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "include_round"
      ]
    },
    "ClientBody": {
      "description": "One command, named by `kind`, and its arguments. Each command reads `args` as its own\nargument type.",
      "type": "object",
      "properties": {
        "kind": {
          "type": "string"
        },
        "args": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": false,
      "required": [
        "kind"
      ]
    }
  }
}
