{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Message",
  "description": "One message on a seat's stream. `id` is chosen by the client and comes back as\n`reply_to` on the reply. `seq` is set by the server, from one counter per host, on\neverything it sends but the hello. The body is nested, so its fields never clash with\nthese.",
  "type": "object",
  "properties": {
    "id": {
      "type": [
        "string",
        "null"
      ]
    },
    "seq": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint64",
      "minimum": 0
    },
    "reply_to": {
      "type": [
        "string",
        "null"
      ]
    },
    "body": {
      "$ref": "#/$defs/ServerBody"
    }
  },
  "required": [
    "body"
  ],
  "$defs": {
    "ServerBody": {
      "description": "What the host sends. A client ignores a kind or a field it does not know.",
      "oneOf": [
        {
          "description": "The first message on a connection, and the only one with no `seq`. On a player seat,\n`open` lists the PCs nobody holds, `taken` the PCs held right now, and `pc_names`\neach one's name by id.",
          "type": "object",
          "properties": {
            "version": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "commands": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "open": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "taken": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "pc_names": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "kind": {
              "type": "string",
              "const": "hello"
            }
          },
          "required": [
            "kind",
            "version",
            "commands"
          ]
        },
        {
          "description": "The reply to `claim`. `token` takes this PC back after a dropped connection.\n`round_index` and `world_time` are the world's round and tick. A new claim carries\n`scrollback`, the speech this PC heard before, oldest first. A claim by token carries\n`missed_messages`, the messages sent to this PC after the `last_seq` it named, and\n`is_missed_truncated` when more than `MISSED_MESSAGE_CAP` messages were missed.",
          "type": "object",
          "properties": {
            "actor": {
              "type": "string"
            },
            "token": {
              "type": "string"
            },
            "round_index": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0,
              "default": 0
            },
            "world_time": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0,
              "default": 0
            },
            "scrollback": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Speech"
              }
            },
            "missed_messages": {
              "type": "array",
              "items": {
                "$ref": "#"
              }
            },
            "is_missed_truncated": {
              "type": "boolean"
            },
            "kind": {
              "type": "string",
              "const": "claimed"
            }
          },
          "required": [
            "kind",
            "actor",
            "token"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "released"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "description": "Sent to the GM whenever a claim starts or ends.",
          "type": "object",
          "properties": {
            "actors_present": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "kind": {
              "type": "string",
              "const": "presence"
            }
          },
          "required": [
            "kind",
            "actors_present"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "refused"
            }
          },
          "$ref": "#/$defs/Refusal",
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "intent": {
              "type": "string"
            },
            "actor": {
              "type": "string"
            },
            "move": {
              "type": "string"
            },
            "target": {
              "type": [
                "string",
                "null"
              ]
            },
            "kind": {
              "type": "string",
              "const": "queued"
            }
          },
          "required": [
            "kind",
            "intent",
            "actor",
            "move"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "say"
            }
          },
          "$ref": "#/$defs/Speech",
          "required": [
            "kind"
          ]
        },
        {
          "description": "One committed round. Every seat gets it.",
          "type": "object",
          "properties": {
            "round_index": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "world_time": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "kind": {
              "type": "string",
              "const": "round"
            }
          },
          "required": [
            "kind",
            "round_index",
            "world_time"
          ]
        },
        {
          "description": "A player's own check. No faces: the GM reads those in `committed`.",
          "type": "object",
          "properties": {
            "outcome": {
              "$ref": "#/$defs/Outcome"
            },
            "kind": {
              "type": "string",
              "const": "check"
            }
          },
          "required": [
            "kind",
            "outcome"
          ]
        },
        {
          "description": "The GM's reply to `commit`, after its rounds.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "committed"
            }
          },
          "$ref": "#/$defs/CommitBody",
          "required": [
            "kind"
          ]
        },
        {
          "description": "The GM's reply to `status`.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "status"
            }
          },
          "$ref": "#/$defs/HostStatus",
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "view"
            }
          },
          "$ref": "#/$defs/View",
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "notes": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/NoteView"
              }
            },
            "kind": {
              "type": "string",
              "const": "resume"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "description": "One narrate line, already the text to print.",
          "type": "object",
          "properties": {
            "text": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "lines"
            }
          },
          "required": [
            "kind",
            "text"
          ]
        },
        {
          "description": "The changes one round showed `viewer`, in the order they happened.",
          "type": "object",
          "properties": {
            "viewer": {
              "type": "string"
            },
            "changes": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/ChangeView"
              }
            },
            "kind": {
              "type": "string",
              "const": "changes"
            }
          },
          "required": [
            "kind",
            "viewer",
            "changes"
          ]
        },
        {
          "description": "The reply to `help`: the commands this player can use now.",
          "type": "object",
          "properties": {
            "commands": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/CommandView"
              }
            },
            "kind": {
              "type": "string",
              "const": "help"
            }
          },
          "required": [
            "kind",
            "commands"
          ]
        },
        {
          "description": "The reply to `map`: each place this player visited.",
          "type": "object",
          "properties": {
            "places": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/PlaceView"
              }
            },
            "kind": {
              "type": "string",
              "const": "map"
            }
          },
          "required": [
            "kind",
            "places"
          ]
        }
      ]
    },
    "Speech": {
      "description": "One line of speech. The GM's copy lists its `recipient_ids`; a player's copy does not.\n`from_name` is the speaking actor's name, left out when the GM speaks as itself.",
      "type": "object",
      "properties": {
        "from": {
          "$ref": "#/$defs/Speaker"
        },
        "from_name": {
          "type": "string"
        },
        "to": {
          "description": "Who hears a say: everyone at the table, everyone in one place, or one actor. On the wire\nit is `\"table\"`, `{\"place\": \"<id>\"}` or `{\"actor\": \"<id>\"}`.",
          "oneOf": [
            {
              "type": "string",
              "enum": [
                "table"
              ]
            },
            {
              "type": "object",
              "properties": {
                "place": {
                  "type": "string"
                }
              },
              "required": [
                "place"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "actor": {
                  "type": "string"
                }
              },
              "required": [
                "actor"
              ],
              "additionalProperties": false
            }
          ]
        },
        "recipient_ids": {
          "description": "Who actually heard it: the ids of the seated players' actors that `to` reached when it\nwas said, plus a seated speaker. `to` is who the speaker addressed; this is who was\nthere, kept because seats and places change later. Empty on a player's copy.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "from",
        "to",
        "text"
      ]
    },
    "Speaker": {
      "description": "Who spoke: the `from` of a speech on the wire and the tape. Written `gm`, `player:<id>` or\n`npc:<id>`; `FromStr` refuses an empty or whitespace id and any other prefix.",
      "type": "string"
    },
    "Code": {
      "description": "The code as a client reads it off the wire: a `Reason` this build knows, or the\ntext of one it does not. Serializes as the bare string either way.",
      "anyOf": [
        {
          "$ref": "#/$defs/Reason"
        },
        {
          "type": "string"
        }
      ]
    },
    "Reason": {
      "description": "Every refusal code. The `code` of a `refused` body, and the token the journal stores on\na round line (`engine::Refusal`).\nStrict and `Copy` on purpose: `spook verify` must fail on a code it does not know.",
      "type": "string",
      "enum": [
        "UNKNOWN_EFFECT",
        "OUT_OF_RANGE",
        "BUDGET",
        "UNKNOWN_ID",
        "VIEWER_MISMATCH",
        "ENGINE_ON_PLAYER",
        "INELIGIBLE",
        "ACTOR_MISMATCH",
        "TABLE_EMPTY",
        "PACK_REV_MISMATCH",
        "RULES_REV_MISMATCH",
        "UNKNOWN_MOVE",
        "UNSCOPED_PERCEIVE",
        "COMMIT_CONFLICT",
        "HAND_EDIT",
        "JOURNAL_DIVERGED",
        "STORE_IO",
        "SCHEMA",
        "NOT_IN_SPEC",
        "TABLE_FULL",
        "SEAT_TAKEN",
        "CHOOSE_PC",
        "MISSING_ITEM",
        "LINE_TOO_LONG",
        "CANT_AFFORD",
        "NOT_A_WEAPON",
        "NO_EXIT",
        "BUSY",
        "TRIGGER_LEAK",
        "AMBIGUOUS_NAME"
      ]
    },
    "Refusal": {
      "description": "Sent from the host to a client as a `refused` body.\nDisplay is the sentence with the code in brackets,\n`The table is full. [TABLE_FULL]`.",
      "type": "object",
      "properties": {
        "code": {
          "$ref": "#/$defs/Code"
        },
        "detail": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "code"
      ]
    },
    "Outcome": {
      "description": "A check band on the player wire, the GM wire, and the rolls in `committed`.",
      "type": "string",
      "enum": [
        "success",
        "partial",
        "miss"
      ]
    },
    "Roll": {
      "description": "One check roll in `CommitBody`, sent from the host to a GM client. Its dice are in the\nbody's `dice` lines.",
      "type": "object",
      "properties": {
        "total": {
          "type": "integer",
          "format": "int64"
        },
        "success_at": {
          "type": "integer",
          "format": "int64"
        },
        "outcome": {
          "$ref": "#/$defs/Outcome"
        }
      },
      "required": [
        "total",
        "success_at",
        "outcome"
      ]
    },
    "CommitBody": {
      "description": "The body of the GM's `committed` reply, sent from the host to a GM client.",
      "type": "object",
      "properties": {
        "state_rev": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "changed_keys": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "journal_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "rolls": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Roll"
          }
        },
        "dice": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "state_rev",
        "changed_keys",
        "rolls"
      ]
    },
    "StatusPresence": {
      "description": "Part of `HostStatus`, sent from the host to a GM client.",
      "type": "object",
      "properties": {
        "players": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "actors_present": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "players",
        "actors_present"
      ]
    },
    "QueuedMove": {
      "description": "A queued move in `HostStatus`, sent from the host to a GM client.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "actor": {
          "type": "string"
        },
        "move": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "actor",
        "move"
      ]
    },
    "PackSummary": {
      "description": "Part of `HostStatus`, sent from the host to a GM client.",
      "type": "object",
      "properties": {
        "menu": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MenuRow"
          }
        },
        "control_types": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/ControlType"
          }
        },
        "places": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "cast": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "gm_notes": {
          "description": "The pack's tone and flavor for the GM, `gm_notes` in `pack.yaml` as written. Left out when\nthe pack has none.",
          "type": "string"
        }
      },
      "required": [
        "menu",
        "control_types",
        "places",
        "cast"
      ]
    },
    "MenuRow": {
      "description": "One cast row in a `PackSummary`, sent from the host to a GM client.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "target": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "target"
      ]
    },
    "ControlType": {
      "description": "Whether a cast entry is an NPC or a PC template, sent from the host to a GM client.",
      "type": "string",
      "enum": [
        "npc",
        "pc_template"
      ]
    },
    "HostStatus": {
      "description": "The body of the GM's `status` reply, sent from the host to a GM client.",
      "type": "object",
      "properties": {
        "presence": {
          "$ref": "#/$defs/StatusPresence"
        },
        "world_time": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "round_index": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "state_rev": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "pack_rev": {
          "type": "string"
        },
        "last_round_at": {
          "type": "string"
        },
        "queued": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/QueuedMove"
          }
        },
        "pack": {
          "$ref": "#/$defs/PackSummary"
        }
      },
      "required": [
        "presence",
        "world_time",
        "round_index",
        "state_rev",
        "pack_rev",
        "last_round_at",
        "queued",
        "pack"
      ]
    },
    "NoteView": {
      "description": "Part of a `View`, sent from the host to a player client.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "to_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "place_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "to_ids",
        "text"
      ]
    },
    "ItemStack": {
      "description": "Part of a `View`, sent from the host to a player client.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "count": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "name": {
          "description": "The item's name.",
          "type": "string"
        }
      },
      "required": [
        "id",
        "count"
      ]
    },
    "MeterView": {
      "description": "Part of a `View`, sent from the host to a player client. `name` is the pack's name for the\nmeter, left out when it gives none.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "value": {
          "type": "integer",
          "format": "int64"
        },
        "max": {
          "type": "integer",
          "format": "int64"
        }
      },
      "required": [
        "id",
        "value",
        "max"
      ]
    },
    "ExitView": {
      "description": "Part of a `View`, sent from the host to a player client. `path_id` is the path it walks, as\na move's `path` target, a `path_flag` change and a walker's `path:<id>` name it. `name` is\nwhat a player reads for the exit, such as `stairs` or `Docks Street`. `place_id` and\n`place_name` are where it goes.",
      "type": "object",
      "properties": {
        "path_id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "place_id": {
          "type": "string"
        },
        "place_name": {
          "type": "string"
        },
        "ticks": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "locked": {
          "type": "boolean"
        }
      },
      "required": [
        "path_id",
        "name",
        "place_id",
        "place_name",
        "ticks",
        "locked"
      ]
    },
    "View": {
      "description": "Sent from the host to a player client as the `view` body and to a GM client as the\n`perceive` reply. Always written `protocol::View`: the engine's `View` is what the\nserver renders this from.",
      "type": "object",
      "properties": {
        "viewer": {
          "type": "string"
        },
        "place": {
          "type": "string"
        },
        "place_name": {
          "type": "string"
        },
        "body": {
          "type": "string"
        },
        "actor_names": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "cant_act": {
          "description": "Why the viewer can't send a move at all. Empty when they can, and empty today: being\nbusy is `busy`, not this.",
          "type": "string"
        },
        "busy": {
          "description": "What keeps the viewer busy and until when, such as `on the stairs until tick 1300`.\nEmpty when they are free.",
          "type": "string"
        },
        "visible_actors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/NoteView"
          }
        },
        "items": {
          "description": "The items lying in the viewer's place.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/ItemStack"
          }
        },
        "items_carried": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ItemStack"
          }
        },
        "wielded_item_id": {
          "description": "Which of `items_carried` the viewer wields.",
          "type": [
            "string",
            "null"
          ]
        },
        "meters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MeterView"
          }
        },
        "world_meters": {
          "description": "The world's meters this viewer may see, at their current values.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/MeterView"
          }
        },
        "habits": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "exits": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ExitView"
          }
        }
      },
      "required": [
        "viewer",
        "place",
        "visible_actors",
        "notes",
        "items",
        "habits"
      ]
    },
    "ChangeView": {
      "description": "One change of a `changes` body, sent from the host to a player client. `component_id`\nnames what changed, such as `meter`, `item` or `place`. `entity_id` is whose it is as a\nrule's `of` names it: an actor id, `place:<id>`, `story:<id>` or `world`.\n`entity_name` is that actor's, place's or story's name. `entry_id` is which one of the\nentity's, such as the meter or item id, and `entry_name` the item's or meter's name, or for\n`place` the name of the place moved to. `before` and `after` are left out when there was none.",
      "type": "object",
      "properties": {
        "component_id": {
